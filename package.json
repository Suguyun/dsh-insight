{
  "name": "dsh-insight",
  "version": "0.1.2",
  "type": "module",
  "description": "DeepSeek Harness (dsh) 浏览器伴侣：网页划词即解读、侧栏多轮追问、Markdown 渲染，并让 dsh 智能体读取当前页面、抓取网络请求、驱动浏览器。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "chrome-extension",
    "edge-extension",
    "browser",
    "browser-agent",
    "browser-automation",
    "selection",
    "insight"
  ],
  "license": "MIT",
  "author": "Suguyun",
  "homepage": "https://github.com/Suguyun/dsh-insight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suguyun/dsh-insight.git"
  },
  "bugs": {
    "url": "https://github.com/Suguyun/dsh-insight/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/run.mjs"
  },
  "bin": {
    "dsh-insight": "bin/cli.js"
  },
  "exports": {
    "./host/bridge.js": "./host/bridge.js",
    "./host/browser-tools.js": "./host/browser-tools.js",
    "./host/insight.js": "./host/insight.js",
    "./host/page-injector.js": "./host/page-injector.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host",
    "extension",
    "bin",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
