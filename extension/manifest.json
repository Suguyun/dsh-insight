{
  "manifest_version": 3,
  "name": "dsh-insight",
  "version": "0.1.0",
  "key": "",
  "description": "DeepSeek Harness (dsh) 浏览器伴侣：划词即解读、侧栏多轮追问、Markdown 渲染，并让 dsh 智能体读取当前页面、抓取网络请求、驱动浏览器。",
  "minimum_chrome_version": "118",
  "permissions": [
    "sidePanel",
    "scripting",
    "tabs",
    "activeTab",
    "storage",
    "debugger",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/selection.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_ui": {
    "page": "src/options.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "打开 dsh-insight 侧栏",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
